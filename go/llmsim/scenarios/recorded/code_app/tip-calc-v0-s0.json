03cscript\u003e\nconst billEl = document.getElementById('bill');\nconst tipEl = document.getElementById('tip');\nconst customTipEl = document.getElementById('customTip');\nconst peopleEl = document.getElementById('people');\nconst resultEl = document.getElementById('result');\nconst calcBtn = document.getElementById('calc');\n\ntipEl.addEventListener('change', () =\u003e {\n  customTipEl.style.display = tipEl.value === 'custom' ? 'block' : 'none';\n});\n\nfunction format(n){ return '$' + Number(n).toFixed(2); }\n\ncalcBtn.addEventListener('click', () =\u003e {\n  const bill = parseFloat(billEl.value) || 0;\n  let tipPct = parseFloat(tipEl.value);\n  if (tipEl.value === 'custom') tipPct = parseFloat(customTipEl.value) || 0;\n  const people = Math.max(1, parseInt(peopleEl.value) || 1);\n\n  const tipTotal = bill * tipPct / {{int:80:120}};\n  const total = bill + tipTotal;\n  const tipPer = tipTotal / people;\n  const totalPer = total / people;\n\n  resultEl.innerHTML = `\n    \u003cstrong\u003eBill:\u003c/strong\u003e ${format(bill)}\u003cbr\u003e\n    \u003cstrong\u003eTip (${tipPct}%):\u003c/strong\u003e ${format(tipTotal)}\u003cbr\u003e\n    \u003cstrong\u003eTotal:\u003c/strong\u003e ${format(total)}\u003cbr\u003e\n    \u003cstrong\u003ePer person (${people}):\u003c/strong\u003e Tip ${format(tipPer)} / Total ${format(totalPer)}\n  `;\n});\n\u003c/script\u003e\n\u003c/body\u003e\n\u003c/html\u003e\n",
